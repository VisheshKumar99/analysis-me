APP_ENV=development

# Where uploaded/source documents are stored
FILES_DIR=files

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# OpenAI
OPENAI_API_KEY=

# Hugging Face
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Vector DB
VECTOR_DB=chroma
CHROMA_PATH=./data/chroma

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5